---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Brand from "../../components/Brand.astro";
import Glyph from "../../components/Glyph.astro";
import NinaMark from "../../components/NinaMark.astro";
import { appStoreListing } from "../../appStore";
---

<BaseLayout
  title="Convite para uma casa na Nina"
  description="Abra este convite no app Nina para participar da organização da casa."
  canonical="/invite/"
  noindex
>
  <header class="invite-header page-shell">
    <Brand />
    <a class="text-link" href="/">Conhecer a Nina</a>
  </header>

  <main id="conteudo" class="invite-page">
    <section class="invite-card" data-invite-card data-invite-state="checking">
      <div class="invite-mark">
        <NinaMark size={64} />
      </div>
      <p class="eyebrow">Convite da Nina</p>
      <h1 data-invite-title>Você foi convidado para uma casa.</h1>
      <p class="invite-description" data-invite-description>
        Estou verificando o convite para preparar seu pedido de entrada.
      </p>
      <div class="invite-code" data-invite-code hidden>
        <span>Código</span>
        <strong></strong>
        <button type="button" aria-label="Copiar código" data-copy-code>
          <Glyph name="copy" size={19} />
        </button>
      </div>
      <div class="invite-status" data-invite-status>
        <span class="spinner" aria-hidden="true"></span>
        Verificando convite
      </div>
      <div class="invite-actions" data-invite-actions hidden>
        <a class="button button-primary button-large" href="#" data-open-app>
          Abrir no app Nina
          <Glyph name="external" size={19} />
        </a>
        <button class="button button-secondary" type="button" data-copy-code>
          Copiar código
        </button>
      </div>
      <div class="invite-install" data-invite-install>
        {
          appStoreListing.isPublished ? (
            <Fragment>
              <p class="invite-install-title">Ainda não tem a Nina no iPhone?</p>
              <p class="invite-install-text">
                Baixe o app e volte para este convite quando terminar.
              </p>
              <a class="invite-install-badge" href={appStoreListing.appStoreURL}>
                <img
                  src="/images/app-store-badge.svg"
                  alt="Baixar a Nina na App Store"
                  width="180"
                  height="60"
                />
              </a>
            </Fragment>
          ) : (
            <Fragment>
              <p class="invite-install-title">A Nina ainda não abriu para todo mundo.</p>
              <p class="invite-install-text">
                O app está sendo preparado para o iPhone. Entre na lista e eu aviso assim que
                ele chegar.
              </p>
              <p class="invite-install-text" data-invite-install-keep>
                Guarde o código acima. Se ele vencer, quem convidou você envia um novo.
              </p>
              <a class="button button-secondary" href="/#lista">
                Entrar na lista da Nina
              </a>
            </Fragment>
          )
        }
      </div>
      <p class="invite-footnote">
        O link não libera acesso sozinho. Uma pessoa responsável pela casa aprova cada pedido.
      </p>
    </section>
  </main>

  <script src="/scripts/invite.js" is:inline></script>
</BaseLayout>
