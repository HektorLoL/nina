---
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Brand from "../../components/Brand.astro";
---

<BaseLayout
  title="Convite para uma casa na Nina"
  description="Abra este convite no app Nina para participar da organização da casa."
  canonical="/invite/"
  noindex
>
  <header class="invite-header page-shell">
    <Brand />
    <a class="text-link" href="/">Conhecer a Nina</a>
  </header>

  <main class="invite-page">
    <section class="invite-card" data-invite-card>
      <div class="invite-avatar-wrap">
        <img src="/images/nina-app-icon.png" alt="Nina" width="104" height="104" />
        <span><Icon name="ph:house-fill" size={25} /></span>
      </div>
      <p class="eyebrow mint">Convite da Nina</p>
      <h1 data-invite-title>Você foi convidado para uma casa.</h1>
      <p class="invite-description" data-invite-description>
        Estou verificando o convite para preparar seu pedido de entrada.
      </p>
      <div class="invite-code" data-invite-code hidden>
        <span>Código</span>
        <strong></strong>
        <button type="button" aria-label="Copiar código" data-copy-code>
          <Icon name="ph:copy-bold" size={19} />
        </button>
      </div>
      <div class="invite-status" data-invite-status>
        <span class="spinner" aria-hidden="true"></span>
        Verificando convite
      </div>
      <div class="invite-actions" data-invite-actions hidden>
        <a class="button button-primary button-large" href="#" data-open-app>
          Abrir no app Nina
          <Icon name="ph:arrow-square-out-bold" size={19} />
        </a>
        <button class="button button-secondary" type="button" data-copy-code>
          Copiar código
        </button>
      </div>
      <p class="invite-footnote">
        O link não libera acesso sozinho. Uma pessoa responsável pela casa aprova cada pedido.
      </p>
    </section>
  </main>

  <script src="/scripts/invite.js" is:inline></script>
</BaseLayout>
