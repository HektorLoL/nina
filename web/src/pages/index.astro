---
import BaseLayout from "../layouts/BaseLayout.astro";
import Brand from "../components/Brand.astro";
import Glyph from "../components/Glyph.astro";
import NinaMark from "../components/NinaMark.astro";
import StoreAction from "../components/StoreAction.astro";
import TourRow from "../components/TourRow.astro";
import { appStoreListing } from "../appStore";
import {
  availabilityLine,
  avatarTone,
  closingHeadline,
  closingLine,
  exampleDescription,
  heroExample,
  houseStop,
  initial,
  landingFaq,
  ninaStop,
  proposalCopy,
  tasksStop,
  todayStop,
  workloadBands,
  workloadDescription,
  workloadExample,
} from "../landing";
import { waitlistConsentVersion } from "../waitlist";

const navLinks = [
  { href: "#como-funciona", label: "Como funciona" },
  { href: "#preco", label: "Preço" },
  { href: "#privacidade", label: "Privacidade" },
  { href: "#duvidas", label: "Dúvidas" },
] as const;

const balancePoints = [
  "Se não der para desenhar sem chutar, ela não desenha. E diz por quê.",
  "Tarefa sem dono fica com a casa. Nunca sobra no nome de alguém.",
  "Ninguém recebe aviso de que o outro terminou alguma coisa.",
  "Criança e adolescente nunca entram no retrato.",
  workloadExample.method,
];

const privacyCards = [
  {
    glyph: "lock",
    title: "Nada entra sozinho",
    text: "A Nina propõe. Tarefa, lembrete, compra ou semente só existem depois que você confirma.",
  },
  {
    glyph: "server",
    title: "Onde ficam os seus dados",
    text: "Os registros da casa ficam em servidores em São Paulo. O que você escreve para a Nina vai para a OpenAI, nos Estados Unidos, que pode guardar por até 30 dias para evitar abuso. Aqui, a conversa com a Nina é apagada depois de 30 dias.",
  },
  {
    glyph: "people",
    title: "Conversa só para adultos",
    text: "A conversa abre para quem tem 18 anos ou mais na faixa de idade da Apple, depois de aceitar o aviso, que inclui o envio aos Estados Unidos. Cada adulto tem a própria conversa.",
  },
  {
    glyph: "shield",
    title: "Sem senha, sem anúncio",
    text: "A Nina não pede senha nem email: você entra com a conta Apple. O app não tem anúncio nem rastreamento, e a Nina nunca movimenta dinheiro.",
  },
] as const;

const availability = availabilityLine(appStoreListing);
---

<BaseLayout
  title="Nina — a rotina da casa, dividida"
  description="Você conta o que precisa ser feito, do jeito que vier. A Nina propõe tarefas, lembretes e compras, e nada entra na casa antes de você confirmar. Para iPhone."
>
  <header class="site-header" data-header>
    <div class="header-inner page-shell">
      <Brand />
      <nav class="desktop-nav" aria-label="Navegação principal">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
      <StoreAction source="header" kind="ink" class="header-cta" />
      <button
        class="menu-button"
        type="button"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-button
      >
        <Glyph name="menu" size={24} />
      </button>
    </div>
    <nav id="mobile-menu" class="mobile-nav" aria-label="Navegação móvel" data-mobile-menu>
      {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      <StoreAction source="mobile_menu" kind="ink" />
    </nav>
  </header>

  <main id="conteudo">
    <section class="hero page-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Conversa que vira alívio</p>
        <h1 id="hero-title">
          <span class="hero-line">Tira da sua cabeça.</span>{" "}
          <span class="hero-line">Ela propõe, você confirma.</span>
        </h1>
        <p class="lede hero-lede">
          Você conta o que precisa ser feito, do jeito que vier. A Nina propõe tarefas, lembretes
          e compras, e nada entra na casa antes de você confirmar.
        </p>
        <div class="hero-actions">
          <StoreAction source="hero" large arrow />
          <a class="text-link hero-more" href="#como-funciona">Ver como funciona</a>
        </div>
        <p class="hero-footnote">{availability}</p>
      </div>

      <div class="hero-product" data-ritual>
        <figure class="phone">
          <div class="phone-screen">
            <span class="phone-island" aria-hidden="true"></span>
            <div class="phone-head" aria-hidden="true">
              <NinaMark size={26} />
              <strong>Nina</strong>
            </div>
            <p class="bubble bubble-you" aria-hidden="true">{heroExample.message}</p>
            <div class="bubble-row" aria-hidden="true">
              <NinaMark size={22} />
              <p class="bubble bubble-nina">{heroExample.reply}</p>
            </div>
            <div class="proposal">
              <div class="proposal-face" aria-hidden="true">
                <p class="proposal-tag"><Glyph name="plus" size={11} />{proposalCopy.pending}</p>
                <p class="proposal-title">
                  <Glyph name={heroExample.proposal.glyph} size={18} />{heroExample.proposal.title}
                </p>
                <p class="proposal-meta">
                  <span><Glyph name="calendar" size={13} />{heroExample.proposal.when}</span>
                  <span><Glyph name="person" size={13} />{heroExample.proposal.owner}</span>
                </p>
              </div>
              <div class="proposal-actions">
                <button
                  type="button"
                  class="proposal-confirm"
                  data-confirm
                  aria-label={heroExample.confirmLabel}
                >
                  {proposalCopy.create}
                </button>
                <div aria-hidden="true">
                  <em class="is-outline">{proposalCopy.correct}</em>
                  <em>{proposalCopy.decline}</em>
                </div>
              </div>
              <p class="proposal-resolved" aria-hidden="true">
                <Glyph name="check" size={12} />{proposalCopy.resolved}
              </p>
            </div>
            <p class="proposal-disclaimer" aria-hidden="true">{proposalCopy.disclaimer}</p>
            <div class="phone-composer" aria-hidden="true">
              <span>{proposalCopy.composer}</span>
              <i><Glyph name="arrow-up" size={17} /></i>
            </div>
            <div class="phone-tabbar" aria-hidden="true">
              <span class="is-selected"><NinaMark size={24} />Nina</span>
              <span><Glyph name="clock" size={22} />Hoje</span>
              <span><Glyph name="list" size={22} />Tarefas</span>
              <span><Glyph name="house" size={22} />Casa</span>
            </div>
          </div>
          <figcaption class="sr-only">{heroExample.description}</figcaption>
        </figure>

        <div class="phone-captions" aria-live="polite">
          <p class="phone-caption">{heroExample.captionBefore}</p>
          <p class="phone-caption phone-caption-stored">
            {heroExample.captionAfter}{" "}
            <button type="button" class="text-button" data-replay>{heroExample.replay}</button>
          </p>
        </div>
      </div>
    </section>

    <section id="como-funciona" class="section section-plain page-shell" aria-labelledby="como-funciona-title">
      <div class="section-heading">
        <p class="eyebrow">Como funciona</p>
        <h2 id="como-funciona-title">A casa em quatro abas.</h2>
      </div>

      <div class="tour-grid">
        <article class="tour-stop" aria-labelledby={`${ninaStop.id}-title`}>
          <h3 id={`${ninaStop.id}-title`}>
            <span class="tour-stop-icon"><NinaMark size={24} /></span>{ninaStop.title}
          </h3>
          <p class="tour-line">{ninaStop.line}</p>
          <p class="tour-extra">{ninaStop.extra}</p>
          <div class="tour-tray" role="img" aria-label={exampleDescription(ninaStop)}>
            <p class="tour-legend" aria-hidden="true">Exemplo</p>
            <div class="tour-card tour-chat" aria-hidden="true">
              <p class="tour-you">{ninaStop.message}</p>
              <div class="tour-nina">
                <NinaMark size={22} />
                <p>{ninaStop.reply}</p>
              </div>
              <div class="tour-face">
                <p class="proposal-tag"><Glyph name="plus" size={11} />{proposalCopy.pending}</p>
                <p class="tour-face-title">
                  <Glyph name={ninaStop.proposal.glyph} size={18} />{ninaStop.proposal.title}
                </p>
                <p class="tour-face-meta">
                  <span class="is-muted"><Glyph name="seed" size={14} />{ninaStop.proposal.when}</span>
                  <span><Glyph name="person" size={14} />{ninaStop.proposal.owner}</span>
                </p>
              </div>
            </div>
          </div>
        </article>

        <article class="tour-stop" aria-labelledby={`${todayStop.id}-title`}>
          <h3 id={`${todayStop.id}-title`}>
            <span class="tour-stop-icon"><Glyph name="clock" size={24} /></span>{todayStop.title}
          </h3>
          <p class="tour-line">{todayStop.line}</p>
          <p class="tour-extra">{todayStop.extra}</p>
          <div class="tour-tray" role="img" aria-label={exampleDescription(todayStop)}>
            <p class="tour-legend" aria-hidden="true">Exemplo</p>
            <div class="tour-card" aria-hidden="true">
              <p class="tour-group is-late">
                <Glyph name="chevron-down" size={12} />Atrasadas · {todayStop.rows.filter((row) => row.isLate).length}
              </p>
              {todayStop.rows.map((row) => <TourRow {...row} />)}
            </div>
          </div>
        </article>

        <article class="tour-stop" aria-labelledby={`${tasksStop.id}-title`}>
          <h3 id={`${tasksStop.id}-title`}>
            <span class="tour-stop-icon"><Glyph name="list" size={24} /></span>{tasksStop.title}
          </h3>
          <p class="tour-line">{tasksStop.line}</p>
          <p class="tour-extra">{tasksStop.extra}</p>
          <div class="tour-tray" role="img" aria-label={exampleDescription(tasksStop)}>
            <p class="tour-legend" aria-hidden="true">Exemplo</p>
            <div class="tour-card" aria-hidden="true">
              <p class="tour-group">
                <Glyph name="chevron-down" size={12} />{tasksStop.group.title} · {tasksStop.group.rows.length}
              </p>
              {tasksStop.group.rows.map((row) => <TourRow {...row} />)}
              <p class="tour-chips">
                {tasksStop.lists.map((list) => <span>{list.title} {list.count}</span>)}
              </p>
              <p class="tour-seed">
                <Glyph name="seed" size={18} />
                <b>{tasksStop.seed.title}</b>
                <span>{tasksStop.seed.label}</span>
              </p>
            </div>
          </div>
        </article>

        <article class="tour-stop" aria-labelledby={`${houseStop.id}-title`}>
          <h3 id={`${houseStop.id}-title`}>
            <span class="tour-stop-icon"><Glyph name="house" size={24} /></span>{houseStop.title}
          </h3>
          <p class="tour-line">{houseStop.line}</p>
          <p class="tour-extra">{houseStop.extra}</p>
          <div class="tour-tray" role="img" aria-label={exampleDescription(houseStop)}>
            <p class="tour-legend" aria-hidden="true">Exemplo</p>
            <div class="tour-card" aria-hidden="true">
              <p class="tour-strip">
                {
                  houseStop.people.map((person) => (
                    <span class={`tour-avatar tone-${avatarTone(person.name)}`}>{initial(person.name)}</span>
                  ))
                }
                <span class="tour-avatar tour-pet"><Glyph name="paw" size={16} /></span>
                <span class="tour-strip-mark"><NinaMark size={32} /></span>
              </p>
              <p class="tour-strip-caption">{houseStop.caption}</p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section id="sobrecarga" class="section panel panel-grout page-shell split" aria-labelledby="sobrecarga-title">
      <div>
        <p class="eyebrow">O retrato da casa</p>
        <h2 id="sobrecarga-title">Sem porcentagem. Sem placar. Sem ganhador.</h2>
        <p class="split-lede">
          Com pelo menos 6 tarefas abertas com dono, entre 2 pessoas da casa, a Nina desenha como a
          casa está hoje, em três faixas, sem número nenhum. Você não pode comparar duas pessoas com
          uma faixa, e é exatamente por isso que ela é uma faixa.
        </p>
        <ul class="check-list">
          {balancePoints.map((point) => <li><Glyph name="check" size={20} />{point}</li>)}
        </ul>
      </div>
      <div class="workload-example">
        <p class="tour-legend" aria-hidden="true">Exemplo</p>
        <div class="workload-card" data-bands>
          <p class="eyebrow">{workloadExample.eyebrow}</p>
          <h3>{workloadExample.headline}</h3>
          <div class="band-chart" role="img" aria-label={workloadDescription()}>
            <div class="band-axis">
              {workloadBands.map((band) => <span>{band}</span>)}
            </div>
            <div class="band-rows">
              {
                workloadExample.rows.map((row) => (
                  <div>
                    {row.isShared ? (
                      <p class="band-head is-house">
                        <span class="glyph-slot"><Glyph name="house" size={20} /></span>{row.name}
                        <span class="band-word">· {row.band}</span>
                      </p>
                    ) : (
                      <p class="band-head">
                        <i class={`tone-${avatarTone(row.name)}`}>{initial(row.name)}</i>{row.name}
                        <span class="band-word">· {row.band}</span>
                      </p>
                    )}
                    <div class="band-track">
                      {workloadBands.map((band) => (
                        <i
                          class:list={{
                            "is-on": band === row.band && !row.isShared,
                            "is-house": band === row.band && row.isShared,
                          }}
                        />
                      ))}
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
          <p class="workload-caption">{workloadExample.caption}</p>
        </div>
      </div>
    </section>

    <section id="preco" class="section section-plain page-shell" aria-labelledby="preco-title">
      <div class="section-heading">
        <p class="eyebrow">Preço</p>
        <h2 id="preco-title">Começa grátis. O Premium vale para a casa toda.</h2>
      </div>
      <div class="price-grid">
        <article class="price-card">
          <h3>Grátis</h3>
          <p>
            Tarefas, lembretes, compras e sementes para a casa toda. Cada adulto manda até 10
            mensagens por dia para a Nina.
          </p>
        </article>
        <article class="price-card">
          <h3>Nina Premium</h3>
          <p class="price-amount">R$ 24,90 por mês ou R$ 249,90 por ano</p>
          <p>
            Uma assinatura cobre a casa toda e libera até 50 mensagens por dia para cada adulto.
            Quando dois adultos da casa aceitam conversar com a Nina, a casa também recebe o resumo
            semanal nas semanas com movimento.
          </p>
        </article>
      </div>
      <p class="price-terms">
        Teto da casa: 100 mensagens por dia. Assina quem tem 18 anos ou mais na faixa de idade da
        Apple. A assinatura renova sozinha pela App Store e se cancela nos Ajustes do iPhone, em
        Assinaturas, até 24 horas antes da renovação. Apagar a conta não cancela a cobrança.
      </p>
      <a class="text-link section-link" href="/termos/">Condições da assinatura nos Termos</a>
    </section>

    <section id="privacidade" class="section panel panel-ink page-shell privacy-panel" aria-labelledby="privacidade-title">
      <p class="eyebrow">Privacidade</p>
      <h2 id="privacidade-title">O que ela lê, e por quanto tempo fica.</h2>
      <p class="privacy-lede">
        O material da escola, a lista do mercado, a conta que vence. Você escreve do seu jeito, a
        Nina monta a proposta. Você confere e confirma.
      </p>
      <ul class="privacy-cards">
        {
          privacyCards.map((card) => (
            <li>
              <Glyph name={card.glyph} size={24} />
              <strong>{card.title}</strong>
              <span>{card.text}</span>
            </li>
          ))
        }
      </ul>
      <p class="privacy-links">
        <a class="text-link" href="/privacidade/">Ler a política de privacidade</a>
        <a class="text-link" href="/denuncia/">Denunciar um problema</a>
      </p>
    </section>

    <section id="duvidas" class="section section-plain page-shell faq-section" aria-labelledby="faq-title">
      <div class="faq-heading">
        <h2 id="faq-title">Dúvidas frequentes</h2>
        <a class="text-link section-link" href="/suporte/">Mais respostas em Suporte</a>
      </div>
      <div class="faq-list">
        {
          landingFaq.map((item) => (
            <details>
              <summary>
                {item.question}
                <Glyph name="plus" size={17} />
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="section section-plain page-shell final-cta" aria-labelledby="final-title">
      <NinaMark size={72} class="is-waiting" />
      <p class="speech">{closingLine}</p>
      <h2 id="final-title">{closingHeadline(appStoreListing)}</h2>
      <p class="final-footnote">{availability}</p>
      <StoreAction source="footer" large />
    </section>
  </main>

  {
    !appStoreListing.isPublished && (
      <dialog
        class="waitlist-dialog"
        data-waitlist-dialog
        aria-labelledby="waitlist-title"
        aria-describedby="waitlist-description"
      >
        <button class="dialog-close" type="button" aria-label="Fechar" data-close-waitlist>
          <Glyph name="close" size={20} />
        </button>
        <NinaMark size={56} />
        <div data-waitlist-entry>
          <p class="eyebrow">Aviso de lançamento</p>
          <h2 id="waitlist-title">Entre na lista da Nina.</h2>
          <p id="waitlist-description">
            Deixe seu email para receber um aviso quando a primeira versão estiver pronta.
          </p>

          <form
            class="waitlist-form"
            data-waitlist-form
            data-consent-version={waitlistConsentVersion}
            novalidate
          >
            <label class="waitlist-field" for="waitlist-email">
              <span>Email</span>
              <input
                id="waitlist-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                maxlength="254"
                placeholder="voce@exemplo.com"
                required
                aria-describedby="waitlist-email-hint"
              />
              <small id="waitlist-email-hint" class="waitlist-hint">
                Um email só, quando a Nina chegar. Seus dados ficam em servidores em São Paulo.
              </small>
            </label>

            <label class="waitlist-field" for="waitlist-first-name">
              <span>Como quer ser chamado? <small>opcional</small></span>
              <input
                id="waitlist-first-name"
                name="firstName"
                type="text"
                autocomplete="given-name"
                maxlength="80"
                placeholder="Seu nome"
              />
            </label>

            <div class="waitlist-honeypot" aria-hidden="true">
              <label for="waitlist-website">Seu site</label>
              <input
                id="waitlist-website"
                name="website"
                type="text"
                autocomplete="off"
                tabindex="-1"
              />
            </div>

            <label class="waitlist-consent">
              <input name="consent" type="checkbox" required />
              <span>
                Quero receber um aviso por email quando a Nina estiver pronta. Posso cancelar
                quando quiser.
              </span>
            </label>

            <button class="button button-primary button-large waitlist-submit" type="submit">
              <span data-waitlist-submit-label>Entrar na lista</span>
              <Glyph name="arrow-right" size={19} />
            </button>
            <p class="waitlist-status" data-waitlist-status role="status" aria-live="polite"></p>
            <p class="waitlist-terms">
              Ao entrar na lista você aceita a <a href="/privacidade/" target="_blank" rel="noopener">Política de Privacidade</a>.
            </p>
          </form>
        </div>

        <div class="waitlist-success" data-waitlist-success hidden>
          <span class="waitlist-success-icon"><Glyph name="check" size={26} /></span>
          <h2>Pronto, você está na lista.</h2>
          <p>Quando a Nina estiver pronta para chegar à sua casa, avisaremos por email.</p>
          <button class="button button-secondary" type="button" data-close-waitlist>Fechar</button>
        </div>
      </dialog>
    )
  }

  <script src="/scripts/home.js" is:inline></script>
</BaseLayout>
