---
import BaseLayout from "../layouts/BaseLayout.astro";
import Brand from "../components/Brand.astro";
import Glyph from "../components/Glyph.astro";
import NinaMark from "../components/NinaMark.astro";
import { waitlistConsentVersion } from "../waitlist";

const steps = [
  {
    number: "1",
    glyph: "chat",
    title: "Você fala",
    text: "Conte o que precisa, do jeito que veio na cabeça. Pode ser uma coisa só ou várias de uma vez.",
  },
  {
    number: "2",
    glyph: "nina",
    title: "A Nina entende",
    text: "Ela lê, mostra o que entendeu e espera. Nada entra na casa sozinho.",
  },
  {
    number: "3",
    glyph: "people",
    title: "Você confirma",
    text: "O que você confirma vira tarefa, lembrete ou semente, com dono e prazo, para a casa inteira.",
  },
] as const;

const features = [
  "Entende prioridades e prazos",
  "Sugere quem fica com o quê — quem decide é você",
  "Lembra no momento certo",
  "Se ajusta quando a vida muda",
  "Lê boleto, receita e comunicado por foto, no Nina Premium",
];

const balancePoints = [
  "Se não der para desenhar sem chutar, ela não desenha. E diz por quê.",
  "Tarefa sem dono fica com a casa. Nunca sobra no nome de alguém.",
  "Ninguém recebe aviso de que o outro terminou alguma coisa.",
  "O retrato faz parte do Nina Premium.",
];

const privacyCards = [
  {
    glyph: "lock",
    title: "A foto não fica guardada",
    text: "Nenhum servidor guarda o seu documento. O que sobra é o que a Nina leu e uma miniatura no seu aparelho.",
  },
  {
    glyph: "close",
    title: "Ela não copia a linha digitável",
    text: "Para pagar você abre o boleto no banco. A Nina lembra do vencimento, ela não movimenta dinheiro.",
  },
  {
    glyph: "server",
    title: "Onde ficam os seus dados",
    text: "Os seus registros ficam em servidores em São Paulo. Para ler o que você escreve, a Nina usa um modelo fora do Brasil, e pede que ele não guarde o que recebe.",
  },
] as const;

const faq = [
  {
    question: "A Nina funciona sem internet?",
    answer:
      "Algumas informações já carregadas continuam visíveis, mas conversa, sincronização e convites precisam de internet.",
  },
  {
    question: "Posso usar se moro sozinho?",
    answer:
      "Pode. O retrato da casa fica dormindo, porque com um adulto só não tem o que comparar, mas as tarefas, as compras, os lembretes e as sementes funcionam igual.",
  },
  {
    question: "Como a Nina ajuda a dividir as tarefas?",
    answer:
      "Ela desenha como a casa está dividida em três faixas — leve, parecido, mais pesado — sem número e sem ranking. É um retrato para conversar, não para cobrar.",
  },
  {
    question: "Posso editar ou apagar o que eu confirmei?",
    answer:
      "Pode. Quem cria, muda ou apaga é você. A Nina só propõe, e nada existe até você tocar em confirmar.",
  },
  {
    question: "A Nina funciona no iPhone e Android?",
    answer:
      "A primeira versão está sendo preparada para iPhone. A expansão para outras plataformas será comunicada depois.",
  },
];
---

<BaseLayout
  title="Nina — menos coisas na cabeça, mais casa acontecendo junto"
  description="Fale do seu jeito. A Nina lê, monta a proposta e espera você confirmar: tarefas, lembretes e uma rotina mais leve para toda a casa."
>
  <header class="site-header" data-header>
    <div class="header-inner page-shell">
      <Brand />
      <nav class="desktop-nav" aria-label="Navegação principal">
        <a href="#como-funciona">Como funciona</a>
        <a href="#recursos">O que a Nina faz</a>
        <a href="#privacidade">Privacidade</a>
        <a href="#duvidas">Dúvidas</a>
      </nav>
      <button
        class="button button-ink header-cta"
        type="button"
        data-open-waitlist
        data-waitlist-source="header"
      >
        Quero conhecer
      </button>
      <button
        class="menu-button"
        type="button"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-button
      >
        <Glyph name="menu" size={24} />
      </button>
    </div>
    <nav id="mobile-menu" class="mobile-nav" aria-label="Navegação móvel" data-mobile-menu>
      <a href="#como-funciona">Como funciona</a>
      <a href="#recursos">O que a Nina faz</a>
      <a href="#privacidade">Privacidade</a>
      <a href="#duvidas">Dúvidas</a>
      <button
        class="button button-ink"
        type="button"
        data-open-waitlist
        data-waitlist-source="mobile_menu"
      >
        Quero conhecer
      </button>
    </nav>
  </header>

  <main id="conteudo">
    <section class="hero page-shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Conversa que vira alívio</p>
        <h1 id="hero-title">Tira da sua cabeça. Ela cuida do resto.</h1>
        <p class="lede hero-lede">
          A Nina é uma amiga que mora no seu celular. Você conta o que precisa ser feito, do
          jeito que veio na cabeça. Ela transforma em tarefa, lembrete, compra — e espera você
          confirmar.
        </p>
        <div class="hero-actions">
          <button
            class="button button-primary button-large"
            type="button"
            data-open-waitlist
            data-waitlist-source="hero"
          >
            Quero conhecer a Nina
            <Glyph name="arrow-right" size={19} />
          </button>
          <a class="button button-secondary button-large" href="#como-funciona">
            Ver como funciona
          </a>
        </div>
        <p class="hero-footnote">
          iPhone · em português · sua casa e suas tarefas ficam em São Paulo
        </p>
      </div>

      <div class="hero-product" data-ritual>
        <figure class="phone" role="img" aria-label="Na conversa, você escreve que o boleto do condomínio vence dia 10. A Nina responde que leu assim e pede que você corrija antes de confirmar, e mostra uma proposta ainda inexistente: pagar o condomínio, segunda 10 de agosto, todo mês, dono a casa, com os botões confirmar, corrigir e ignorar.">
          <div class="phone-screen">
            <span class="phone-island"></span>
            <div class="phone-head">
              <NinaMark size={26} />
              <strong>Nina</strong>
            </div>
            <p class="bubble bubble-you">o boleto do condomínio vence dia 10</p>
            <div class="bubble-row">
              <NinaMark size={22} />
              <p class="bubble bubble-nina">Li assim. Corrija antes de confirmar.</p>
            </div>
            <div class="proposal">
              <p class="proposal-tag">Isto ainda não existe</p>
              <p class="proposal-title"><i></i>Pagar o condomínio</p>
              <p class="proposal-row"><span>Quando</span><strong>segunda, 10 de agosto</strong></p>
              <p class="proposal-row"><span>Repete</span><strong>todo mês</strong></p>
              <p class="proposal-row"><span>Dono</span><strong>A casa, por enquanto</strong></p>
              <div class="proposal-actions">
                <b>Confirmar e criar 1 tarefa</b>
                <div><em>Corrigir</em><em>Ignorar</em></div>
              </div>
            </div>
            <p class="phone-waiting">A Nina está esperando você.</p>
            <div class="phone-composer">
              <span>Escreve pra Nina</span>
              <i><Glyph name="arrow-up" size={17} /></i>
            </div>
          </div>
        </figure>

        <article class="floating-note note-one">
          <Glyph name="chat" size={20} />
          <p><strong>Ideia solta</strong>Comprar o presente da professora até sexta</p>
        </article>
        <article class="floating-note note-two">
          <Glyph name="bell" size={20} />
          <p><strong>Lembrete</strong>Renovar o plano de internet</p>
        </article>
        <article class="floating-note note-three">
          <Glyph name="seed" size={20} />
          <p><strong>Semente</strong>Um dia, pintar o corredor</p>
        </article>
      </div>
    </section>

    <section id="como-funciona" class="section panel page-shell">
      <div class="section-heading centered">
        <p class="eyebrow">Sem precisar aprender um sistema</p>
        <h2>Da conversa à ação, em 3 passos</h2>
      </div>
      <div class="steps-grid">
        {
          steps.map((step, index) => (
            <article class="step">
              <div class="step-top">
                <span class="step-number">{step.number}</span>
                {step.glyph === "nina" ? <NinaMark size={30} /> : <Glyph name={step.glyph} size={28} />}
              </div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              {index < steps.length - 1 && (
                <Glyph name="arrow-right" size={26} class="step-arrow" />
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section id="recursos" class="section panel panel-grout page-shell split">
      <div>
        <p class="eyebrow">Organização que se adapta à sua casa</p>
        <h2>Da bagunça mental para a rotina leve.</h2>
        <p>
          A Nina entende o contexto da casa e monta um plano prático que funciona de verdade.
        </p>
        <ul class="check-list">
          {features.map((feature) => <li><Glyph name="check" size={20} />{feature}</li>)}
        </ul>
      </div>
      <div class="phone-gallery" role="img" aria-label="As telas Hoje, Tarefas e Casa do aplicativo Nina: a agenda do dia com atrasadas e sem dono, as tarefas agrupadas por categoria com uma semente, e a casa com três pessoas mais a Nina.">
        <figure class="phone">
          <div class="phone-screen">
            <span class="phone-island"></span>
            <p class="mini-eyebrow">14 de agosto</p>
            <p class="mini-title">Boa tarde, Mirna</p>
            <div class="mini-counts">
              <div class="is-yours"><strong>6</strong><span>na sua mão</span></div>
              <div class="is-late"><strong>2</strong><span>atrasadas</span></div>
              <div><strong>1</strong><span>sem dono</span></div>
            </div>
            <div class="mini-chips">
              <span class="is-on">Tudo 9</span><span>Minhas</span><span>Sementes</span>
            </div>
            <p class="mini-eyebrow">Atrasadas · 2</p>
            <p class="mini-row late"><i></i><b>Condomínio</b><em>Ontem</em></p>
            <p class="mini-row late"><i></i><b>Vacina do Bidu</b><em>Terça</em></p>
            <p class="mini-eyebrow">Hoje · 3</p>
            <p class="mini-row"><i></i><b>Reunião de pais</b><em>19h</em></p>
            <p class="mini-row"><i></i><b>Ração do Bidu</b><em>Hoje</em></p>
          </div>
        </figure>
        <figure class="phone phone-center">
          <div class="phone-screen">
            <span class="phone-island"></span>
            <p class="mini-title">Tarefas</p>
            <p class="mini-eyebrow">9 abertas</p>
            <p class="mini-eyebrow">Contas · 3</p>
            <p class="mini-row"><i></i><b>Conta de luz</b><em>Sexta</em></p>
            <p class="mini-row"><i></i><b>IPVA</b><em>Dia 20</em></p>
            <p class="mini-eyebrow">Escola · 2</p>
            <p class="mini-row"><i></i><b>Autorização</b><em>Sexta</em></p>
            <p class="mini-eyebrow">Cuidado · 2</p>
            <p class="mini-row"><i></i><b>Pediatra do Téo</b><em>—</em></p>
            <p class="mini-eyebrow">Sementes · 3</p>
            <p class="mini-row is-seed"><i></i><span><b>Pintar a sala</b><em>Plante depois</em></span></p>
          </div>
        </figure>
        <figure class="phone">
          <div class="phone-screen">
            <span class="phone-island"></span>
            <p class="mini-title">Casa Castello</p>
            <p class="mini-eyebrow">3 pessoas + Nina</p>
            <div class="mini-person">
              <i>MI</i><span><b>Mirna</b><em>Mãe · dona da casa</em></span>
            </div>
            <div class="mini-person">
              <i class="tone-2">RA</i><span><b>Rafa</b><em>Pai</em></span>
            </div>
            <div class="mini-person">
              <i class="tone-3">TE</i><span><b>Téo</b><em>Filho</em></span>
            </div>
            <div class="mini-person">
              <span class="mark-slot"><NinaMark size={24} /></span>
              <span><b>Nina</b><em>IA da casa · não ocupa vaga</em></span>
            </div>
            <p class="mini-eyebrow">Sobrecarga</p>
            <div class="band-track band-track-mini">
              <i></i><i></i><i class="is-on"></i>
            </div>
          </div>
        </figure>
      </div>
    </section>

    <section class="section panel page-shell split">
      <div>
        <p class="eyebrow">Sinal de sobrecarga</p>
        <h2>Sem porcentagem. Sem placar. Sem ganhador.</h2>
        <p>
          Quando a casa teve movimento suficiente, a Nina desenha como ela está dividida — em
          três faixas, sem número nenhum. Você não pode comparar duas pessoas com uma faixa, e é
          exatamente por isso que ela é uma faixa.
        </p>
        <ul class="check-list">
          {balancePoints.map((point) => <li><Glyph name="check" size={20} />{point}</li>)}
        </ul>
      </div>
      <div class="workload-card" data-bands aria-label="Exemplo do retrato de carga da casa">
        <p class="eyebrow eyebrow-faint">Sinal de sobrecarga · domingo</p>
        <h3>A casa está pesando mais de um lado.</h3>
        <div class="band-axis">
          <span>leve</span><span>parecido</span><span>mais pesado</span>
        </div>
        <div class="band-rows">
          <div>
            <p class="band-head"><i>MI</i>Mirna</p>
            <div class="band-track"><i></i><i></i><i class="is-on"></i></div>
          </div>
          <div>
            <p class="band-head"><i class="tone-2">RA</i>Rafa</p>
            <div class="band-track"><i></i><i class="is-on"></i><i></i></div>
          </div>
          <div>
            <p class="band-head is-house">
              <span class="glyph-slot"><Glyph name="house" size={21} /></span>A casa — sem dono
            </p>
            <div class="band-track"><i class="is-house"></i><i></i><i></i></div>
          </div>
        </div>
        <p class="workload-caption">Um retrato para conversar, não para cobrar.</p>
      </div>
    </section>

    <div class="support-grid page-shell">
      <section id="privacidade" class="section panel panel-ink privacy-panel">
        <p class="eyebrow">Boleto, receita, comunicado</p>
        <h2>O que ela lê, e o que ela não guarda.</h2>
        <p>
          O boleto da escola, a receita do pediatra, o comunicado que veio na mochila. Você tira
          a foto, a Nina lê o que dá para ler e monta a proposta. Você confere e confirma.
        </p>
        <ul class="privacy-cards">
          {
            privacyCards.map((card) => (
              <li>
                <Glyph name={card.glyph} size={24} />
                <strong>{card.title}</strong>
                <span>{card.text}</span>
              </li>
            ))
          }
        </ul>
        <a class="text-link" href="/privacidade">Ler política de privacidade</a>
      </section>

      <section id="duvidas" class="section panel faq-panel" aria-labelledby="faq-title">
        <p class="eyebrow">Direto ao ponto</p>
        <h2 id="faq-title">Dúvidas frequentes</h2>
        <div class="faq-list">
          {
            faq.map((item) => (
              <details>
                <summary>
                  {item.question}
                  <Glyph name="plus" size={17} />
                </summary>
                <p>{item.answer}</p>
              </details>
            ))
          }
        </div>
      </section>
    </div>

    <section class="section panel panel-wash final-cta page-shell">
      <NinaMark size={72} />
      <div class="final-copy">
        <p class="speech">Quer uma casa mais leve?</p>
        <h2>A Nina já está esperando a sua mensagem.</h2>
      </div>
      <ul class="check-list compact">
        <li><Glyph name="check" size={18} />Do seu jeito, no seu ritmo</li>
        <li><Glyph name="check" size={18} />Menos carga mental no dia a dia</li>
        <li><Glyph name="check" size={18} />Mais tempo junto, menos cobrança</li>
      </ul>
      <button
        class="button button-primary button-large"
        type="button"
        data-open-waitlist
        data-waitlist-source="footer"
      >
        Quero conhecer a Nina
      </button>
    </section>
  </main>

  <footer class="site-footer page-shell">
    <Brand compact />
    <p>Nina © {new Date().getFullYear()}. Organização da casa com mais leveza.</p>
    <nav aria-label="Links legais">
      <a href="/privacidade">Privacidade</a>
      <a href="/termos">Termos</a>
      <a href="mailto:oi@ninai.app">Contato</a>
    </nav>
  </footer>

  <dialog
    class="waitlist-dialog"
    data-waitlist-dialog
    aria-labelledby="waitlist-title"
    aria-describedby="waitlist-description"
  >
    <button class="dialog-close" type="button" aria-label="Fechar" data-close-waitlist>
      <Glyph name="close" size={20} />
    </button>
    <NinaMark size={56} />
    <div data-waitlist-entry>
      <p class="eyebrow">Primeiros convites</p>
      <h2 id="waitlist-title">Entre na lista da Nina.</h2>
      <p id="waitlist-description">
        Deixe seu email para receber um aviso quando a primeira versão estiver pronta.
      </p>

      <form
        class="waitlist-form"
        data-waitlist-form
        data-consent-version={waitlistConsentVersion}
        novalidate
      >
        <label class="waitlist-field" for="waitlist-first-name">
          <span>Como quer ser chamado? <small>opcional</small></span>
          <input
            id="waitlist-first-name"
            name="firstName"
            type="text"
            autocomplete="given-name"
            maxlength="80"
            placeholder="Seu nome"
          />
        </label>

        <label class="waitlist-field" for="waitlist-email">
          <span>Email</span>
          <input
            id="waitlist-email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            maxlength="254"
            placeholder="voce@exemplo.com"
            required
          />
        </label>

        <div class="waitlist-honeypot" aria-hidden="true">
          <label for="waitlist-website">Seu site</label>
          <input
            id="waitlist-website"
            name="website"
            type="text"
            autocomplete="off"
            tabindex="-1"
          />
        </div>

        <label class="waitlist-consent">
          <input name="consent" type="checkbox" required />
          <span>
            Quero receber novidades da Nina por email. Posso cancelar quando quiser e li a
            <a href="/privacidade">Política de Privacidade</a>.
          </span>
        </label>

        <button class="button button-primary button-large waitlist-submit" type="submit">
          <span data-waitlist-submit-label>Entrar na lista</span>
          <Glyph name="arrow-right" size={19} />
        </button>
        <p class="waitlist-status" data-waitlist-status role="status" aria-live="polite"></p>
      </form>
    </div>

    <div class="waitlist-success" data-waitlist-success hidden>
      <span class="waitlist-success-icon"><Glyph name="check" size={26} /></span>
      <h2>Pronto, você está na lista.</h2>
      <p>Quando a Nina estiver pronta para chegar à sua casa, avisaremos por email.</p>
      <button class="button button-secondary" type="button" data-close-waitlist>Fechar</button>
    </div>
  </dialog>

  <script src="/scripts/home.js" is:inline></script>
</BaseLayout>
