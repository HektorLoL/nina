---
import BaseLayout from "../layouts/BaseLayout.astro";
import Brand from "../components/Brand.astro";
import NinaMark from "../components/NinaMark.astro";
---

<BaseLayout
  title="Página não encontrada — Nina"
  description="Esse endereço não existe na Nina."
  canonical="/404/"
  noindex
>
  <header class="invite-header page-shell">
    <Brand />
    <a class="text-link" href="/">Conhecer a Nina</a>
  </header>

  <main id="conteudo" class="invite-page">
    <section class="invite-card">
      <div class="invite-mark">
        <NinaMark size={64} />
      </div>
      <p class="eyebrow">Nina</p>
      <h1>Esse endereço não existe.</h1>
      <p class="invite-description">
        Se você chegou aqui por um convite, peça o link de novo para quem convidou você.
      </p>
      <div class="invite-actions">
        <a class="button button-primary button-large" href="/">Voltar para o início</a>
      </div>
    </section>
  </main>
</BaseLayout>
