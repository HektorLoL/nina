---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Brand from "../../components/Brand.astro";
import Glyph from "../../components/Glyph.astro";
---

<BaseLayout
  title="Preferências de email | Nina"
  description="Atualize com segurança as preferências de email da lista de lançamento da Nina."
  canonical="/unsubscribe/"
  noindex
>
  <header class="invite-header page-shell">
    <Brand />
    <a class="text-link" href="/">Voltar para a Nina</a>
  </header>

  <main id="conteudo" class="unsubscribe-page">
    <section
      class="unsubscribe-card"
      data-unsubscribe-card
      data-state="loading"
      aria-busy="true"
    >
      <div class="unsubscribe-visual" aria-hidden="true">
        <span class="unsubscribe-badge" data-state-icon="loading">
          <span class="spinner"></span>
        </span>
        <span class="unsubscribe-badge" data-state-icon="confirm">
          <Glyph name="bell-off" size={26} />
        </span>
        <span class="unsubscribe-badge" data-state-icon="success">
          <Glyph name="check" size={26} />
        </span>
        <span class="unsubscribe-badge" data-state-icon="error">
          <Glyph name="alert" size={26} />
        </span>
      </div>

      <p class="eyebrow">Preferências de email</p>
      <h1 data-unsubscribe-title>Abrindo suas preferências...</h1>
      <p
        class="unsubscribe-description"
        data-unsubscribe-description
        aria-live="polite"
      >
        Só um instante enquanto protegemos este link.
      </p>

      <div class="unsubscribe-actions">
        <button
          class="button button-primary button-large"
          type="button"
          data-unsubscribe-submit
          disabled
        >
          <Glyph name="bell-off" size={19} />
          <span>Cancelar novidades</span>
        </button>
        <a class="button button-secondary" href="/" data-unsubscribe-home>
          Continuar na lista
        </a>
      </div>

      <p class="unsubscribe-footnote">
        Esta preferência vale apenas para a lista de lançamento. Uma conta no app, caso exista,
        não será alterada.
      </p>
      <p class="unsubscribe-help">
        Precisa de ajuda? <a href="mailto:oi@ninai.app">oi@ninai.app</a>
      </p>

      <noscript>
        <p class="unsubscribe-noscript">
          Para cancelar sem JavaScript, escreva para{" "}
          <a href="mailto:oi@ninai.app">oi@ninai.app</a>.
        </p>
      </noscript>
    </section>
  </main>

  <script src="/scripts/unsubscribe.js" is:inline></script>
</BaseLayout>
