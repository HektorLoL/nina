---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import { appStoreListing } from "../appStore";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = "/images/og/nina.png",
  imageAlt = "Nina. A rotina da casa, dividida.",
  imageWidth = 1200,
  imageHeight = 630,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(canonical, Astro.site);
const imageURL = new URL(image, Astro.site);
const imageType = image.endsWith(".png") ? "image/png" : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FBFCFD" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {
      appStoreListing.isPublished && (
        <meta name="apple-itunes-app" content={`app-id=${appStoreListing.appStoreID}`} />
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/images/nina-app-icon.png" sizes="1024x1024" />
    <link rel="apple-touch-icon" href="/images/nina-app-icon.png" />
    <link
      rel="preload"
      href="/fonts/Fraunces-Regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Nina" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    {imageType && <meta property="og:image:type" content={imageType} />}
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
    <slot />
    <SiteFooter />
  </body>
</html>
