---
// Category and meaning are carried by a monochrome outline glyph, never by a
// colour. The set is hand-authored on the same 24 grid and stroke weight the
// Paper boards use, so the site draws the same shapes the app does.
interface Props {
  name: keyof typeof glyphs;
  size?: number;
  class?: string;
  label?: string;
}

const glyphs = {
