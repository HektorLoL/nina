const { name, size = 22, class: className, label } = Astro.props;
const glyph = glyphs[name];
const weight = "w" in glyph ? glyph.w : 1.7;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={weight}
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? "img" : "presentation"}
  aria-hidden={label ? undefined : "true"}
>
  {label && <title>{label}</title>}
  {glyph.d.map((d) => <path d={d} />)}
</svg>
