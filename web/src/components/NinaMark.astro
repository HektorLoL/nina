---
interface Props {
  size?: number;
  class?: string;
  title?: string;
}

const { size = 32, class: className, title } = Astro.props;

// Two masters, differing by measurement rather than by scale, transcribed from
// `Nina/NinaMark.swift`. The floor gap between the disc and the inside of the cup
// is the mark's critical dimension and it grows as the mark shrinks: 8.0% of the
// box at 64, 8.3% at 24. Holding requires not gripping.
const large = {
  box: 64,
  d: "M53.14 16.1A22.5 22.5 0 1 1 10.86 16.1",
  band: 10,
  x: 23.6,
  y: 19.4,
  side: 16.8,
  r: 8.4,
};
const small = {
  box: 24,
  d: "M19.71 6.2A8.2 8.2 0 1 1 4.29 6.2",
  band: 4,
  x: 9.3,
  y: 7.8,
  side: 5.4,
  r: 2.7,
};

const m = size < 34 ? small : large;
---

<svg
  class:list={["nina-mark", className]}
  width={size}
  height={size}
  viewBox={`0 0 ${m.box} ${m.box}`}
  fill="none"
  role={title ? "img" : "presentation"}
  aria-hidden={title ? undefined : "true"}
>
  {title && <title>{title}</title>}
  <path
    d={m.d}
    stroke="currentColor"
    stroke-width={m.band}
    stroke-linecap="round"
  />
  {/* The disc is a rounded square rather than a circle only so `Lendo` can
      stretch it into a bar. It must never be trimmed, dashed or rotated: the
      mark is a mass, and a stroked arc that moves is a spinner. */}
  <rect
    class="nina-disc"
    x={m.x}
    y={m.y}
    width={m.side}
    height={m.side}
    rx={m.r}
    fill="currentColor"
  />
</svg>
