# Nina release preflight configuration. Copy to production.env, which is ignored.
# Distribute only the relevant values to each platform; do not upload this whole
# file to Cloudflare, Supabase, GitHub, or App Store Connect.

NINA_PUBLIC_BASE_URL=https://ninai.app

# iOS and Cloudflare public configuration.
NINA_SUPABASE_URL=https://your-project-ref.supabase.co
NINA_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_publishable_key

# Cloudflare Worker only.
NINA_SUPABASE_SECRET_KEY=sb_secret_replace_with_a_dedicated_worker_key
NINA_WAITLIST_HASH_SALT=replace_with_at_least_32_random_characters

# Supabase Edge Functions only.
OPENAI_API_KEY=sk-proj-replace_with_an_openai_project_key
NINA_APP_BUNDLE_ID=com.heitor.nina
NINA_APPLE_TEAM_ID=97PL8KQA8L
NINA_APP_APPLE_ID=6808423946
NINA_PREMIUM_PRODUCT_IDS=com.heitor.nina.premium.monthly,com.heitor.nina.premium.yearly
NINA_APP_STORE_ENVIRONMENT=production
NINA_APP_STORE_ONLINE_CHECKS=true
NINA_AI_V2_ENABLED=NO
NINA_ATTACHMENTS_ENABLED=NO

# Public build-time metadata for the website.
PUBLIC_NINA_APP_STORE_ID=6808423946
PUBLIC_NINA_LEGAL_ENTITY_NAME=replace_with_the_controller_legal_name
PUBLIC_NINA_LEGAL_ENTITY_DOCUMENT=replace_with_the_controller_document
PUBLIC_NINA_PRIVACY_CONTACT_EMAIL=privacidade@ninai.app
PUBLIC_NINA_DPO_NAME=replace_with_the_dpo_name
PUBLIC_NINA_DPO_CONTACT_EMAIL=privacidade@ninai.app
