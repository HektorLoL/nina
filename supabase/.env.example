OPENAI_API_KEY=replace-with-an-openai-project-key

# nina-chat hashes each adult's id with this salt into OpenAI's
# safety_identifier. At least 32 random characters; never logged.
NINA_SAFETY_ID_SALT=replace_with_at_least_32_random_characters

# age-signal. production in the hosted project; development or insecure-local
# are refused unless SUPABASE_URL is a loopback stack. APPLE_APP_ATTEST_ROOT_CA_PEM
# is optional and only replaces the embedded Apple App Attestation Root CA.
NINA_APP_ATTEST_MODE=replace_with_production_or_insecure-local
APPLE_APP_ATTEST_ROOT_CA_PEM=

# delete-account revokes the Sign in with Apple token after a deletion. Paste
# these only into Edge Function secrets; the key never enters the repository.
APPLE_SIGN_IN_TEAM_ID=replace_with_team_id
APPLE_SIGN_IN_KEY_ID=replace_with_key_id
APPLE_SIGN_IN_PRIVATE_KEY=replace_with_the_p8_contents_in_edge_function_secrets_only

# App Store verification. NINA_APP_STORE_ENVIRONMENT stays unset, which verifies
# production first and then sandbox. Set it to xcode or local_testing only in a
# separate test project: those receipts carry no Apple signature.
NINA_APP_BUNDLE_ID=com.heitor.nina
NINA_APP_APPLE_ID=6808423946
NINA_PREMIUM_PRODUCT_IDS=com.heitor.nina.premium.monthly,com.heitor.nina.premium.yearly
NINA_APP_STORE_ONLINE_CHECKS=true

# September 23, 2026 defaults. Override when OpenAI pricing changes.
NINA_GPT_6_LUNA_INPUT_USD_PER_M=0.10
NINA_GPT_6_LUNA_CACHED_INPUT_USD_PER_M=0.01
NINA_GPT_6_LUNA_CACHE_WRITE_USD_PER_M=0.125
NINA_GPT_6_LUNA_OUTPUT_USD_PER_M=0.50
NINA_GPT_5_4_MINI_INPUT_USD_PER_M=0.75
NINA_GPT_5_4_MINI_CACHED_INPUT_USD_PER_M=0.075
NINA_GPT_5_4_MINI_OUTPUT_USD_PER_M=4.50
